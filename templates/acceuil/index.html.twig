{% extends 'base.html.twig' %}

{% block body %}
<div class="c1">
<div class="c2">
<p>📍 Bordeaux</p>
<p>📞 +33 1 23 45 67 89</p>
<p>✉️ vite@gourmand.com</p></div>

</div>

{% block header %} {% include 'header.html.twig' %}{% endblock %}
<section class="c">
<div class="x">
    <div class="jaune"></div>
    <img src="images/slide1.jpg" alt="Salle dressée pour un repas" class="pa">
</div>
<div>
<h2>Vite & Gourmand,<br>
votre traiteur à Bordeaux</h2>
<p>Noël, Pâques, anniversaire ou repas d'entreprise : depuis 25 ans, Julie et José cuisinent pour tous vos événements.<br> Choisissez votre menu, commandez en ligne et nous livrons chez vous.</p>
<button class="b"><a class="a" href="{{ path('app_menu') }}">Découvrir nos menus</a></button>
</div>

</section>

<section id="equipe-section" class="equipe-section">
    <div class="equipe-container">
        <div class="equipe-image">
            <img src="{{ asset('images/about-kitchen.jpg') }}" alt="L'équipe Vite & Gourmand en cuisine">
        </div>

        <div class="equipe-content">
            <span class="equipe-subtitle">— QUI SOMMES-NOUS</span>
            <h2 class="equipe-title">Julie et José, votre traiteur pour tous vos événements</h2>

            <p class="equipe-text">
                Depuis 25 ans à Bordeaux, Julie et José préparent des menus pour tous vos événements : un simple repas de Noël ou de Pâques, un anniversaire, une fête de famille ou un repas d'entreprise.
            </p>
            <p class="equipe-text">
                Vous choisissez votre menu, vous nous donnez la date, l'adresse et le nombre de personnes, et nous nous occupons du reste : nous cuisinons et nous livrons chez vous. Nos menus changent selon les saisons et existent en version classique, végétarienne ou végane.
            </p>

            <div class="equipe-grid">
                <div class="equipe-item">
                    <div class="equipe-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div>
                        <h4>25 ans d'expérience</h4>
                        <p>Des clients fidèles à Bordeaux</p>
                    </div>
                </div>

                <div class="equipe-item">
                    <div class="equipe-icon">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <div>
                        <h4>Livraison à domicile</h4>
                        <p>À Bordeaux et dans les environs</p>
                    </div>
                </div>

                <div class="equipe-item">
                    <div class="equipe-icon">
                        <i class="fa-solid fa-utensils"></i>
                    </div>
                    <div>
                        <h4>Fait maison</h4>
                        <p>Cuisiné par Julie et José</p>
                    </div>
                </div>

                <div class="equipe-item">
                    <div class="equipe-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div>
                        <h4>Hygiène & sécurité</h4>
                        <p>Normes respectées</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section id="menu">
               <span class="titre">Nos menus</span>
               <h2 class="stitre">Des menus pour <span>tous vos événements</span></h2>
               <div class="sligne"></div>

               <div class="conteneur">
               <button class="choix active" data-choix="all">Tous</button>
               <button class="choix" data-choix="Noël">Noël</button>
               <button class="choix" data-choix="Pâques">Pâques</button>
               <button class="choix" data-choix="Classique">Classique</button>
               <button class="choix" data-choix="Événement">Événement</button>
               </div>

<div class="menus">
{% for menu in menus %}
<div class="m" data-menu="{{ menu.theme }}">
    <img src="{{ asset('images/' ~ menu.image) }}" alt="{{ menu.titre }}">
    <span class="m-theme">{{ menu.theme }}</span>
    <h3>{{ menu.titre }}</h3>
    <p class="m-infos">{{ menu.regime }} · à partir de {{ menu.nbrpersonnes }} personnes</p>
    <p class="prix">{{ menu.prix }} € / pers.</p>
    <a class="m-lien" href="{{ path('app_menu_detail', { id: menu.id }) }}">Voir le détail</a>
</div>
{% endfor %}
</div>

<p id="aucun-menu-accueil" style="display: none;">Aucun menu pour ce thème pour le moment.</p>

<button class="b"><a href="{{ path('app_menu') }}" class="a">Voir tous les menus</a></button>
</section>


<section id="chef">
              <span class="titre">Les Maîtres du Goût</span>
               <h2 class="stitre">Découvrez nos <span>Chefs d'Exception</span></h2>
               <div class="sligne"></div>
<div class="chefs">
<div class="ch">
<img src="images/chef1.webp" alt="chef1">
    <h3>Alice Mortal</h3>
        <div class="chef">
        Head Chef
        </div>
    <p class="prix">12 years experience</p>
</div>
<div class="ch">
<img src="images/chef2.jpeg" alt="chef2">
<h3>Michael Corn</h3>
<div class="chef">
Grill Master
</div>
<p class="prix">8 years experience</p>
</div>
<div class="ch">
<img src="images/chef3.avif" alt="chef3">
<h3>Faz Chowdel</h3>
<div class="chef">
Pastry Chef
</div>
<p class="prix">10 years experience</p>
</div>
<div class="ch">
<img src="images/chef4.jpeg" alt="chef4">
<h3>Rose Latnum</h3>
<div class="chef">
Pizza Artisan
</div>
<p class="prix">9 years experience</p>
</div>
</div>
</section>


<section id="avis">
               <span class="titre">Vos Mots Doux</span>
               <h2 class="stitre">Les retours de <span>nos gourmands</span></h2>
               <div class="sligne"></div>
<div class="slider-mask">
<div class="image-container">
<div class="av">
<div class="étoiles">
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i> <i class="fas fa-star"></i>
</div>
<p>Les burgers sont incroyables, la viande est juteuse et les produits sont super frais. Je recommande à 100% !</p>
<img src="images/per1.jpeg" alt="image">
</div>
<div class="av">
<div class="étoiles">
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i> <i class="fas fa-star"></i>
</div>
<p>Commande servie rapidement et bien chaude. Le personnel est très accueillant, nous reviendrons très vite.</p>
<img src="images/per2.jpeg" alt="image">
</div>
<div class="av">
<div class="étoiles">
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i> <i class="fas fa-star"></i>
</div>
<p>La pâte à pizza est fine et croustillante comme il faut. Une excellente adresse pour bien manger.  </p>
<img src="images/per3.jpeg" alt="image">
</div>
<div class="av">
<div class="étoiles">
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i> <i class="fas fa-star"></i>
</div>
<p>Des portions généreuses, des prix très raisonnables et un goût au rendez-vous. Rien à redire ! </p>
<img src="images/per4.jpeg" alt="image">
</div>
<div class="av">
<div class="étoiles">
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i> <i class="fas fa-star"></i>
</div>
<p> Cadre super agréable et plats faits maison. On passe toujours un bon moment ici.</p>
<img src="images/per5.jpeg" alt="image">
</div>
{%for a in avis%}
{%if a.statut == "publié"%}
<div class="av">
<div class="étoiles">
{%for note in 1..a.note %}
<i class="fas fa-star"></i>
{%endfor%}
</div>
<p>{{a.commentaire}}.</p>
<p>{{a.usernom}}
</div>
{% endif %}
{%endfor%}
<div class="av">
<div class="étoiles">
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i>
<i class="fas fa-star"></i> <i class="fas fa-star"></i>
</div>
<p> La qualité des ingrédients est au rendez-vous et l'assaisonnement est impeccable. Une vraie pépite !</p>
<img src="images/per6.jpeg" alt="image">
</div>
</div>
</div>
</section>

<div class="modal fade" id="formModal" tabindex="-1" aria-labelledby="formModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      
      <div class="modal-header">
        <h5 class="modal-title" id="formModalLabel">Mon Formulaire</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>

      <!-- Corps de la modale : Contient le formulaire -->
      <div class="modal-body">
      <form action="{{path ('app_connexion' )}}" method="POST">
<h2 style="text-align: center;">se connecter</h2>
<div>
<label for="email">adresse email:</label>
<input type="text" id="email" name="email"  placeholder="john@doe.com">
</div>
<div>
<label for="mdp">mot de passe:</label>
<input type="password" id="mdp" name="mdp">
</div>
<p>si vous avez pas un compte veuillez vous <a href="inscription">incrire</a> ?</p>

<button class="b" type="submit">se connecter</button>

</form>
</div>

    </div>
  </div>
</div>
{% block footer %} {% include 'footer.html.twig' %}{% endblock %}
<script src="{{ asset('js/acceuil.js') }}"></script>
{% endblock %}
