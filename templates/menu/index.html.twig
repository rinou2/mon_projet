{% extends 'base.html.twig' %}
{% block body %}
{% block header %} {% include 'header.html.twig' %}{% endblock %}
<div id="menu">

            <span class="titre">What's Cooking</span>
            <h2 class="stitre">Our Delicious <span>Menu</span></h2>
            <div class="sligne"></div>
            <div class="conteneur">
                <button class="choix" data-choix="all">All</button>
                <button class="choix" data-choix="tacos">Tacos</button>
                <button class="choix" data-choix="pizza">Pizzas</button>
                <button class="choix" data-choix="burger">Burgers</button>
                <button class="choix" data-choix="pasta">Pastas</button>
               
            </div>

<div class="menus">
{% for menu in menus %}          
<div class="m1" >
<img src="{{ asset('images/'~ menu.image)}}" alt="{{menu.titre}}">
<h3>{{menu.titre}}</h3>
<p>{{menu.description}}</p>
<p class="prix"> {{ menu.prix }} €</p>
<button class="b1"><a class="a" href="{{ path('app_commande', { id: menu.id }) }}"> Commander </a> </button>
</div>

{% endfor %} 


{% endblock %}