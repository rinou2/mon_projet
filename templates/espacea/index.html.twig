{% extends 'espacea/layout.html.twig' %}
{% block title %}Administration{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/Acceuil.css') }}">
{% endblock %}
{% block contenu %}
    <h1>Tableau de bord</h1>
    <p>Bonjour {{ app.user.nom }}.</p>
    <form method="get" action="" id="filtres" style="margin-bottom: 20px;">
    <label for="periode">Période : </label>
    <select name="periode" id="periode" onchange="this.form.submit()">
        <option value="3" {% if app.request.query.get('periode') == '3' %}selected{% endif %}>3 derniers mois</option>
        <option value="6" {% if app.request.query.get('periode') == '6' or not app.request.query.has('periode') %}selected{% endif %}>6 derniers mois</option>
        <option value="12" {% if app.request.query.get('periode') == '12' %}selected{% endif %}>12 derniers mois</option>
    </select>
</form>
    <div class="stats">
        <div class="stat-carte">
            <p class="stat-titre"><i class="fa-solid fa-coins"></i> Revenus ce mois</p>
            <p class="stat-valeur">{{ revenusMois|number_format(2, ',', ' ') }} £</p>
        </div>
        <div class="stat-carte">
            <p class="stat-titre"><i class="fa-solid fa-user-tie"></i> Employés</p>
            <p class="stat-valeur">{{ nbEmployes }}</p>
        </div>
        <div class="stat-carte">
            <p class="stat-titre"><i class="fa-solid fa-utensils"></i> Commandes par menu</p>
            <ul class="stat-liste">
                {% for titre, nombre in commandesParMenu %}
                    <li><span>{{ titre }}</span><strong>{{ nombre }}</strong></li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <canvas id="graph" style="backgournd-color:beige;" width="800px" height="500px">Canvas not supported</canvas>
    <canvas id="graphCommandesMenu" width="800" height="450" style="background-color: #f0f0f0; margin-bottom: 30px;">Canvas not supported</canvas>
    <canvas id="graphCAMenu" width="800" height="450" style="background-color: #f0f0f0; margin-bottom: 30px;">Canvas not supported</canvas>
  <script>
  const tab = {{ tab|json_encode|raw }};
  const labels = {{ labels|json_encode|raw }};
  const menuLabels = {{ menuLabels|json_encode|raw }};
  const menuValues = {{ menuValues|json_encode|raw }};
  const caMenuLabels = {{ caMenuLabels|json_encode|raw }};
  const caMenuValues = {{ caMenuValues|json_encode|raw }};

  const canvasElement = document.getElementById('graph');
  const canvasElement2 = document.getElementById('graphCommandesMenu');
  const canvasElement3 = document.getElementById('graphCAMenu');

  const ctx = canvasElement.getContext('2d');

  ctx.font = "bold 14px Arial, sans-serif";
  ctx.fillStyle = "#333333";
  ctx.fillText("Chiffre d'affaires mensuel", 50, 30);

    const ctx2 = canvasElement2.getContext('2d');

  ctx2.font = "bold 14px Arial, sans-serif";
  ctx2.fillStyle = "#333333";
  ctx2.fillText("Nombre de commandes par menu", 50, 30);

    const ctx3 = canvasElement3.getContext('2d');

  ctx3.font = "bold 14px Arial, sans-serif";
  ctx3.fillStyle = "#333333";
  ctx3.fillText("Chiffre d'affaires par menu", 50, 30);

  const createAxeX = (marks, scale, unit, label) => {
    const distance=(ctx.canvas.width -100)/marks
    ctx.beginPath();
    ctx.moveTo(50, ctx.canvas.height - 50);
    ctx.lineTo(ctx.canvas.width - 50, ctx.canvas.height - 50);
    ctx.stroke();
    if(label){
        ctx.fillText(label, ctx.canvas.width /2, ctx.canvas.height - 10);
    }
    for(var i=0;i<=marks;i++){
        ctx.beginPath();
        ctx.moveTo(50+i*distance, ctx.canvas.height - 50);
        ctx.lineTo(50+i*distance, ctx.canvas.height - 40);
        ctx.stroke();
        ctx.fillText(labels[i], 50+i*distance, ctx.canvas.height - 30);
        ctx.strokeStyle = "#e0e0e0";
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(50 + i * distance, 50);
        ctx.lineTo(50 + i * distance, ctx.canvas.height - 50);
        ctx.stroke();
    }
}
const createBarAxeX = (ctx, labelsArr, label) => {
    const canvasWidth = ctx.canvas.width;
    const canvasHeight = ctx.canvas.height;
    const distance = (canvasWidth - 100) / labelsArr.length;

    ctx.beginPath();
    ctx.strokeStyle = "#333333";
    ctx.moveTo(50, canvasHeight - 50);
    ctx.lineTo(canvasWidth - 50, canvasHeight - 50);
    ctx.stroke();

    if (label) {
     ctx.fillText(label, canvasWidth / 2, canvasHeight - 10);
    }

    labelsArr.forEach((menuName, i) => {
    let x = 50 + (i * distance) + (distance / 2);
    ctx.save();
    ctx.translate(x, canvasHeight - 35);
    ctx.rotate(-0.2);
    ctx.textAlign = "right";
    ctx.fillStyle = "#333333";
    ctx.font = "11px Arial, sans-serif";
    ctx.fillText(menuName, 0, 0);
    ctx.restore();
    });
}
const fillTextVertically = (text, x, y) => {
    const lineHeight = 10;
    y = y - lineHeight * text.length / 2;
    ctx.textAlign = "center";
    for (var i = 0; i < text.length; i += 1) {
        ctx.fillText(text[i], x, y + i * lineHeight);
    }
}
const createAxeY= (ctx,marks, scale, unit, label) => {
    const distance=(ctx.canvas.height -100)/marks
   ctx.beginPath();
   ctx.moveTo(50,50);
    ctx.lineTo(50, ctx.canvas.height - 50);
    ctx.stroke();
    if(label){
        fillTextVertically(label,5,ctx.canvas.height /2);
    }
    for( var i = 1; i <= marks; i ++){
        ctx.beginPath();
        ctx.moveTo(50,ctx.canvas.height - 50 - i * distance);
        ctx.lineTo(45,ctx.canvas.height - 50 - i * distance );
        ctx.stroke();
        if(unit){
            ctx.fillText(i*scale+unit,10,ctx.canvas.height - 50 - i * distance);
        }
        ctx.strokeStyle = "#e0e0e0";
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(50, ctx.canvas.height - 50 - i * distance);
        ctx.lineTo(ctx.canvas.width - 50, ctx.canvas.height - 50 - i * distance);
        ctx.stroke();
    }
}
const generatePoints = (size,color) => {
    const points = [];
    for (var j = 0; j < tab.length; j++) {
        points.push({
            x: j,
            y: tab[j],
            color: color 
        });
    }
    return points;  
}
const drawLineAndFill = (points, marks_x, scale_x, marks_y, scale_y) => {
    const transform_x = marks_x * scale_x / (ctx.canvas.width - 100);
    const transform_y = marks_y * scale_y / (ctx.canvas.height - 100);
    if (points.length === 0) return;
    const baseY = ctx.canvas.height - 50;
    ctx.beginPath();
    const firstX = 50 + points[0].x / transform_x;
    ctx.moveTo(firstX, baseY);
    points.forEach(point => {
        const x = 50 + point.x / transform_x;
        const y = baseY - point.y / transform_y;
        ctx.lineTo(x, y);
    });
    
    const lastPoint = points[points.length - 1];
    const lastX = 50 + lastPoint.x / transform_x;
    ctx.lineTo(lastX, baseY);
    ctx.closePath();
    ctx.fillStyle = "rgba(217, 83, 79, 0.15)"; 
    ctx.fill();
    ctx.beginPath();
    points.forEach((point, index) => {
        const x = 50 + point.x / transform_x;
        const y = baseY - point.y / transform_y;
        if (index === 0) {
            ctx.moveTo(x, y);
        } else {
            ctx.lineTo(x, y);
        }
    });
    
    ctx.strokeStyle = "red";
    ctx.lineWidth = 3; 
    ctx.stroke();
};
const drawBars = (ctx, values, marks_y, scale_y, color) => {
    const canvasWidth = ctx.canvas.width;
    const canvasHeight = ctx.canvas.height;
    const baseY = canvasHeight - 50;
    const transform_y = marks_y * scale_y / (canvasHeight - 100);
    const distance = (canvasWidth - 100) / values.length;
    const barWidth = distance * 0.6;
    values.forEach((val, i) => {
        const x = 50 + (i * distance) + (distance - barWidth) / 2;
        const barHeight = val / transform_y;
        const y = baseY - barHeight;
        ctx.fillStyle = color;
        ctx.fillRect(x, y, barWidth, barHeight);

        ctx.fillStyle = "#333333";
        ctx.font = "bold 12px Arial, sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(val, x + (barWidth / 2), y - 8);
    })
}
    createAxeY(ctx,10,1000,"£",undefined);
    createAxeX(tab.length - 1,100,undefined,undefined);
    const points = generatePoints(tab.length, "red");
    drawLineAndFill(points,tab.length - 1,1,10,1000);

    createAxeY(ctx2, 10, 2, "", undefined);
    createBarAxeX(ctx2, menuLabels, undefined);
    drawBars(ctx2, menuValues, 10, 2, "#d9534f");

    createAxeY(ctx3, 10, 1000, "£", undefined);
    createBarAxeX(ctx3, caMenuLabels, undefined);
    drawBars(ctx3, caMenuValues, 10, 1000, "#2ecc71");

  </script>
{% endblock %}
