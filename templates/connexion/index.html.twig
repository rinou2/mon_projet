{% extends 'base.html.twig' %}

{% block title %}Hello ConnexionController!{% endblock %}

{% block body %}
{% block header %} {% include 'header.html.twig' %}{% endblock %}

<img class="res" src="images/ruya.png" alt="res">

<form action="{{path ('app_connexion' )}}" method="POST">
<h2 style="text-align: center;">se connecter</h2>
<div>
<label for="email">adresse email:</label>
<input type="text" id="email" name="email"  placeholder="john@doe.com">
</div>
<div>
<label for="mdp">mot de passe:</label>
<input type="password" id="mdp" name="mdp">
</div>
<p>si vous avez pas un compte veuillez vous <a href="inscription">incrire</a> ?</p>
 {% if error %}
    <div class="erreur">
        {{ error.messageKey }}
    </div>
    {% endif %}
<button class="b" type="submit">se connecter</button>

</form>
{% endblock %}
